# ===== LLM Provider =====
# ollama = 本地模型（开发机 / 有 GPU 的服务器）
# openai_compatible = 云端 OpenAI 兼容 API（阿里百炼 / 硅基流动 / DeepSeek）
LLM_PROVIDER=ollama

# ---- 本地 Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b
OLLAMA_CODE_MODEL=qwen2.5-coder:7b

# ---- 云端 OpenAI 兼容 API（LLM_PROVIDER=openai_compatible 时生效）----
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen-plus

# ===== LLM 参数 =====
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120

# ===== Embedding =====
# 固定使用 Chroma 内置 ONNX MiniLM（384 维），更换会导致向量库不兼容
EMBEDDING_PROVIDER=onnx_mini_lm

# ===== 数据目录 =====
CHROMA_PERSIST_DIR=d:\vue\chroma_db
UPLOAD_DIR=d:\vue\uploads
MAX_UPLOAD_SIZE_MB=100

# ===== 服务端口 =====
BACKEND_PORT=8000
FRONTEND_PORT=5173
